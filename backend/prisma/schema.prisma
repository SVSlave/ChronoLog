generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  userName  String    @unique
  sessions  Session[]
  createdAt DateTime  @default(now())

  @@map("users")
}

model Session {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  topic       String
  description String
  startDate   DateTime  @default(now())
  endDate     DateTime?

  @@map("sessions")
}
